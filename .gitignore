# --- Python / Django ---
Backend/.venv/
__pycache__/
*.py[cod]
Backend/db.sqlite3
Backend/db.sqlite3-wal
Backend/db.sqlite3-shm
Backend/.env
# Also ignore env variants and backups (.env.local, .env.bak, .env.old-laptop-bak, ...)
# so a copy of the real secrets can never be committed by accident.
Backend/.env.*
!Backend/.env.example
Backend/media/
Backend/staticfiles/
.pytest_cache/

# --- Node / Vite ---
Frontend/node_modules/
Frontend/dist/
Frontend/.vite/
*.local

# --- Dev runner ---
.run/

# --- Downloaded CI logs (from deploy-notification emails) ---
pipeline.log

# --- Personal server-ops archive (not part of this project's codebase) ---
Server-Documentation/

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
